{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vscode",
	"main": "src/index.js",
	"compatibility_date": "2026-08-13",
	"cache": {
		"enabled": true
	},
	"vars": {
		"PRIVATE_BASE": "http://10.64.10.40:8000"
	},
	"vpc_networks": [
		{
			"binding": "MESH",
			"network_id": "cf1:network",
			"remote": true
		}
	]
}
